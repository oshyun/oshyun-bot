# 기본값 파일 — 이 파일은 자동으로 로드됩니다. 변경은 .env 에서 하세요.
# .env 에 있는 값이 이 파일의 값보다 우선합니다.
# 이 파일은 셸 스크립트가 source 로도 로드하므로, 값에 공백이 있으면 반드시 따옴표로 감싼다.
#
# 💡 환경변수 도메인 네이밍 가이드:
# 환경변수의 역할과 소속을 명확히 구분하기 위해 `도메인__키=값` 형식을 사용합니다.
# (예: TELEGRAM__BOT_TOKEN, AGENT__WORKDIR, CALENDAR__ICAL_URL, WEB__PORT 등)
# 기존 레거시 키(단일 언더스코어)도 100% 하위 호환됩니다.

# ── 1. 텔레그램 도메인 (TELEGRAM__) ──────────────────────────────────────
# TELEGRAM__BOT_TOKEN=                     # 텔레그램 봇 토큰 (BotFather 발급)
# TELEGRAM__ALLOWED_CHAT_IDS=              # 허용 chat_id 목록 (쉼표 구분)
# TELEGRAM__LOG_PATH=_bot/bot-log.md       # 볼트 내 대화/운영 기록 마크다운 경로

# ── 2. 에이전트 & 작업공간 도메인 (AGENT__) ──────────────────────────────
# AGENT__WORKDIR=~                         # Obsidian 볼트 디렉토리 절대경로
# AGENT__CODEDIR=                          # 코드 작업 디렉토리 절대경로 (비우면 코딩 비활성)
# AGENT__MODEL=                            # 기본 모델 (미지정 시 Sonnet tier)
# AGENT__CODE_EFFORT_LEVEL=max
# AGENT__CODE_EXPERIMENTAL_AGENT_TEAMS=1
# AGENT__CODE_AUTO_COMPACT_WINDOW=1000000
# AGENT__CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
AGENT__TIMEOUT=0                           # 에이전트 실행 타임아웃(초). 0이면 무제한 대기.
AGENT__LOG_PATH=_bot/bot-log.md

# ── 3. LLM API / 프록시 도메인 (ANTHROPIC__) ──────────────────────────────
# ANTHROPIC__BASE_URL 을 선언한 경우에만 아래 값들이 필요합니다 (세트로 .env 에 설정).
# 선언하지 않으면 claude 기본값(Anthropic 정식 — Sonnet 등)을 그대로 씁니다.
# ANTHROPIC__AUTH_TOKEN=                   # 프록시 API 토큰 (비밀키) — 반드시 .env 에만 둔다
# ANTHROPIC__BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC__MODEL=glm-5.3-flash[1m]
# ANTHROPIC__API_TIMEOUT_MS=3000000
# ANTHROPIC__DEFAULT_HAIKU_MODEL=glm-5.3-flash[1m]
# ANTHROPIC__DEFAULT_SONNET_MODEL=glm-5.3-flash[1m]
# ANTHROPIC__DEFAULT_OPUS_MODEL=glm-5.3-flash[1m]

# ── 4. 캘린더 사이드카 도메인 (CALENDAR__) ───────────────────────────────
# CALENDAR__ICAL_URL=                      # 구글 캘린더 비공개 iCal 주소 (비우면 비활성)
CALENDAR__NOTE_PATH=_bot/캘린더.md
CALENDAR__YEARS_AHEAD=3
CALENDAR__YEARS_BACK=3
CALENDAR__INTERVAL=300
CALENDAR__REFRESH_TRIGGER=_bot/.cal-refresh
CALENDAR__REFRESH_POLL=5
# Google Calendar API OAuth 파일 경로 (선택 — 미지정 시 data/state/ 하위 자동 사용)
# CALENDAR__CREDENTIALS_FILE=data/state/google_credentials.json
# CALENDAR__TOKEN_FILE=data/state/google_token.json

# ── 5. 웹 서버 & 실시간 음성 비서 도메인 (WEB__) ─────────────────────────
WEB__ENABLED=1
WEB__HOST=127.0.0.1
WEB__PORT=8765
WEB__AUTH_REQUIRED=1
# 외부 접속 시 보호할 비밀 토큰 (미지정 시 24자리 난수 자동 생성)
WEB__TOKEN=
# macOS 환경에서 정적 파일 서빙 시 HTTP 헤더 누락 방지
WEB__AIOHTTP_NOSENDFILE=1
# 마스터 감독 루프 하위 에이전트 주기 점검(초). 0이면 자동 점검을 끄고 수동 요청 시에만 점검.
WEB__MASTER_PATROL_INTERVAL=0

# ── 6. DuckDNS & SSL 도메인 (DUCKDNS__) ─────────────────────────────────
# DUCKDNS__DOMAIN=your-subdomain
# DUCKDNS__TOKEN=                          # DuckDNS 계정 고유 토큰 (duckdns.org)
# WEB__SSL_ENABLED=1                       # 1: 활성, 0: 비활성 (인증서 존재 시 자동 감지)

# ── 7. 시스템 공통 도메인 (SYSTEM__) ────────────────────────────────────
# SYSTEM__DATA_DIR=data                    # 운영 산출물 위치 (기본: <루트>/data)

# ── 8. 레거시 키 하위 호환성 기본값 (단일 언더스코어) ───────────────────
AGENT_TIMEOUT=0
BOT_LOG_PATH=_bot/bot-log.md
CAL_NOTE_PATH=_bot/캘린더.md
CAL_YEARS_AHEAD=3
CAL_YEARS_BACK=3
CAL_INTERVAL=300
CAL_REFRESH_TRIGGER=_bot/.cal-refresh
CAL_REFRESH_POLL=5
WEB_ENABLED=1
WEB_HOST=127.0.0.1
WEB_PORT=8765
WEB_AUTH_REQUIRED=1
AIOHTTP_NOSENDFILE=1
MASTER_PATROL_INTERVAL=0
