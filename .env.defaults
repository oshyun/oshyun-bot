# 기본값 파일 — 이 파일은 자동으로 로드됩니다. 변경은 .env 에서 하세요.
# .env 에 있는 값이 이 파일의 값보다 우선합니다.
# 이 파일은 셸 스크립트가 source 로도 로드하므로, 값에 공백이 있으면 반드시 따옴표로 감싼다.

# ── 필수 (반드시 .env 에 설정) ──────────────────────────────────────────
# GOOGLE_ICAL_URL=          # 비우면 캘린더 사이드카 비활성

# ── 봇 ─────────────────────────────────────────────────────────────────
# AGENT_WORKDIR=~
# 에이전트 실행 타임아웃(초). 0이면 무제한 대기.
AGENT_TIMEOUT=0
# 기본 모델. 비우면 Sonnet tier(아래 ANTHROPIC_DEFAULT_SONNET_MODEL, 없으면 'sonnet').
# AGENT_MODEL=
# /coding 명령어로 접근할 코드 작업 디렉토리. 비우면 /coding 비활성.
# AGENT_CODEDIR=

# ── claude CLI · API 프록시 ──────────────────────────────────────────────
# ANTHROPIC_BASE_URL 를 선언한 경우에만 아래 값들이 필요하다(세트로 .env 에 설정).
# 선언하지 않으면 claude 기본값(Anthropic 정식 — Sonnet 등)을 그대로 쓴다.
# ANTHROPIC_DEFAULT_*_MODEL 세 값은 /model 패널 후보(Haiku/Sonnet/Opus 버튼)를 자동 구성한다.
# ANTHROPIC_AUTH_TOKEN=                 # 프록시 API 토큰(비밀) — 반드시 .env 에만 둔다
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-4.7
# ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.2[1m]
# ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.2[1m]
# API_TIMEOUT_MS=3000000

BOT_LOG_PATH=_bot/bot-log.md

# ── 캘린더 사이드카 ─────────────────────────────────────────────────────
CAL_NOTE_PATH=_bot/캘린더.md
CAL_YEARS_AHEAD=3
CAL_YEARS_BACK=3
CAL_INTERVAL=300
CAL_REFRESH_TRIGGER=_bot/.cal-refresh
CAL_REFRESH_POLL=5
# Google Calendar API (일정 조절/생성/삭제/조회) OAuth 파일 경로 (선택 — 미지정 시 data/state/ 하위 자동 사용)
# GOOGLE_CREDENTIALS_FILE=data/state/gcal_credentials.json
# GOOGLE_TOKEN_FILE=data/state/gcal_token.json

# ── Flutter Web / 세컨브레인 볼트 매니저 & 실시간 웹 서버 ─────────────────
WEB_ENABLED=1
WEB_HOST=127.0.0.1
WEB_PORT=8765
WEB_AUTH_REQUIRED=1
# 외부 접속 시 보호할 비밀 토큰 (미지정 시 24자리 난수 자동 생성)
WEB_TOKEN=
# macOS 환경에서 정적 파일 서빙 시 HTTP 헤더 누락 방지
AIOHTTP_NOSENDFILE=1
# 마스터 감독 루프 하위 에이전트 주기 점검(초). 0이면 자동 점검을 끄고 수동 요청 시에만 점검.
MASTER_PATROL_INTERVAL=0

# ── DuckDNS & SSL ──────────────────────────────────────────────────────────
# DUCKDNS_DOMAIN=your-subdomain
# DUCKDNS_TOKEN=             # DuckDNS 계정 고유 토큰 (duckdns.org 상단)
# WEB_SSL_ENABLED=1          # 1: 활성, 0: 비활성 (인증서 존재 시 자동 감지)




