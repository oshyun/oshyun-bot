#!/usr/bin/env python3
"""session-ctl — 총괄 에이전트(Core Orchestrator)가 모든 AGY/Claude 채팅 세션을 모니터링하고 제어하는 CLI 도구.

여기서 각 '채팅방(room)'은 고유한 `session_id`를 가진 AGY 세션(`conversation_id`)이다.
총괄 에이전트는 이 도구를 통해:
1. `list`  — 활성 채팅방(AGY 세션) 목록, 상태(실행 중/대기열), 최근 대화 요약을 조회한다.
2. `read`  — 특정 채팅방(AGY 세션)의 대화 내역(`chat.db`) 및 AGY 브레인 실행 기록(`transcript.jsonl`)을 열람한다.
3. `send`  — 특정 채팅방(AGY 세션)에 메시지를 보내 실행(`--conversation <session_id>`)시킨다 (동기 대기 또는 비동기 위임).
4. `spawn` — 새로운 주제의 채팅방(신규 AGY 세션)을 생성하고 초기 프롬프트를 보내 작업을 시작시킨다.
"""

from __future__ import annotations

import argparse
import json
import os
import ssl
import sys
import urllib.error
import urllib.parse
import urllib.request


def _load_env() -> None:
    """리포지토리 루트의 .env 파일을 자동으로 로드한다."""
    script_dir = os.path.dirname(os.path.abspath(__file__))
    root_dir = os.path.dirname(script_dir)
    for env_name in (".env.defaults", ".env"):
        env_file = os.path.join(root_dir, env_name)
        if os.path.exists(env_file):
            try:
                with open(env_file, "r", encoding="utf-8") as f:
                    for line in f:
                        line = line.strip()
                        if line and not line.startswith("#") and "=" in line:
                            k, v = line.split("=", 1)
                            k = k.strip()
                            v = v.strip().strip("'\"")
                            if env_name == ".env" or k not in os.environ:
                                os.environ[k] = v
            except Exception:
                pass


def _get_api_config() -> tuple[str, str]:
    _load_env()
    host = os.getenv("WEB_HOST", os.getenv("VOICE_WEB_HOST", "127.0.0.1")).strip() or "127.0.0.1"
    if host in ("0.0.0.0", "::"):
        host = "127.0.0.1"
    port = os.getenv("WEB_PORT", os.getenv("VOICE_WEB_PORT", "8765")).strip() or "8765"
    base_url = os.getenv("OSHYUN_ORCHESTRATOR_API_URL", "").strip()
    if not base_url or (port != "8765" and base_url in ("http://127.0.0.1:8765", "http://localhost:8765")):
        base_url = f"http://{host}:{port}"
    base_url = base_url.rstrip("/")
    token = os.getenv("WEB_TOKEN", os.getenv("OSHYUN_ORCHESTRATOR_TOKEN", os.getenv("VOICE_WEB_TOKEN", ""))).strip()
    return base_url, token


def _api_request(method: str, path: str, payload: dict | None = None, timeout: int = 620) -> dict:
    base_url, token = _get_api_config()
    url = f"{base_url}{path}"
    headers = {"Accept": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"

    data_bytes = None
    if payload is not None:
        headers["Content-Type"] = "application/json; charset=utf-8"
        data_bytes = json.dumps(payload, ensure_ascii=False).encode("utf-8")

    req = urllib.request.Request(url, data=data_bytes, headers=headers, method=method)
    ssl_context = None
    if url.startswith("https://"):
        ssl_context = ssl.create_default_context()
        ssl_context.check_hostname = False
        ssl_context.verify_mode = ssl.CERT_NONE
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=ssl_context) as resp:
            raw = resp.read().decode("utf-8", "replace")
            return json.loads(raw) if raw.strip() else {"ok": True}
    except urllib.error.HTTPError as e:
        err_body = ""
        try:
            err_body = e.read().decode("utf-8", "replace")
            parsed_err = json.loads(err_body)
            return {"ok": False, "error": parsed_err.get("error") or parsed_err.get("message") or f"HTTP {e.code}"}
        except Exception:
            return {"ok": False, "error": f"HTTP {e.code}: {err_body or e.reason}"}
    except Exception as e:
        return {"ok": False, "error": f"API 연결 실패 ({url}): {e}"}


def cmd_list(args: argparse.Namespace) -> int:
    query = f"?limit={int(args.limit)}"
    res = _api_request("GET", f"/api/orchestrator/sessions{query}", timeout=15)
    if not res.get("ok"):
        print(f"⚠️ 세션 목록 조회 실패: {res.get('error')}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0

    sessions = res.get("sessions") or []
    running_cnt = sum(1 for s in sessions if s.get("isRunning"))
    print(f"=== 🗂️ 전체 채팅방 (AGY 세션) 목록: 총 {len(sessions)}개 (실행 중: {running_cnt}개) ===")
    if not sessions:
        print("현재 열려 있는 일반 채팅 세션이 없습니다.")
        return 0

    for idx, s in enumerate(sessions, 1):
        rid = s.get("id") or ""
        sid = s.get("sessionId") or "(미할당/새 세션)"
        title = s.get("title") or "새 대화"
        msg_cnt = s.get("messageCount") or 0
        is_running = s.get("isRunning", False)
        q_cnt = s.get("queueSize") or 0
        status_str = "🟢 실행 중" if is_running else "⚪ 대기"
        if q_cnt > 0:
            status_str += f" (대기열 {q_cnt}건)"
        updated_str = s.get("updatedAtFormatted") or ""
        summary = (s.get("summary") or "").replace("\n", " ").strip()
        preview = (s.get("preview") or "").replace("\n", " ").strip()
        print(f"\n[{idx}] 제목: {title}")
        print(f"    • ID (roomId / sessionId): {rid}  (AGY Session: {sid})")
        print(f"    • 상태: {status_str} | 메시지: {msg_cnt}개 | 최근 활동: {updated_str}")
        if summary and summary != preview:
            print(f"    • 📋 요약: {summary[:160]}")
        elif preview:
            print(f"    • 최근 내용: {preview[:120]}")
    return 0


def cmd_read(args: argparse.Namespace) -> int:
    target = urllib.parse.quote(args.target.strip())
    q_params = f"?target={target}&limit={int(args.limit)}"
    if args.include_brain:
        q_params += "&brain=1"
    res = _api_request("GET", f"/api/orchestrator/session/read{q_params}", timeout=20)
    if not res.get("ok"):
        print(f"⚠️ 세션 열람 실패: {res.get('error')}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0

    room = res.get("session") or res.get("room") or {}
    rsum = res.get("roomSummary") or {}
    messages = res.get("messages") or []
    brain_info = res.get("brain") or {}

    print(f"=== 📖 채팅방(AGY 세션) 상세 열람: [{room.get('title', '대화방')}] ===")
    print(f"• Room ID    : {room.get('id')}")
    print(f"• Session ID : {room.get('sessionId') or '(미할당)'}")
    print(f"• 상태       : {'🟢 실행 중 (' + (room.get('liveFeed') or '작업 중') + ')' if room.get('isRunning') else '⚪ 대기 중'}")
    print(f"• 메시지 수  : 총 {room.get('messageCount', len(messages))}개 (최근 {len(messages)}개 표시)")
    summary_text = (rsum.get("summary") or room.get("summary") or "").strip()
    if summary_text:
        print(f"• 📋 누적 요약본: {summary_text}")
    if rsum.get("queries"):
        print(f"• 💬 다룬 질문들: {' / '.join(str(q) for q in rsum['queries'][-4:])}")

    if brain_info.get("artifacts"):
        print(f"• AGY Brain 아티팩트: {', '.join(brain_info['artifacts'])}")

    print("\n--- 💬 대화 내역 ---")
    if not messages:
        print("(대화 내역이 없습니다.)")
    for m in messages:
        role = m.get("role") or m.get("sender") or "user"
        channel = m.get("channel") or "web"
        role_label = "👤 사용자" if role == "user" else "🤖 에이전트(AGY)"
        if channel == "orchestrator" and role == "user":
            role_label = "마스터 에이전트 지시"
        created = m.get("createdAtFormatted") or ""
        text = (m.get("text") or "").strip()
        steps = m.get("steps") or []
        print(f"\n[{role_label}] {created}")
        if steps:
            step_titles = [st.get("title") or st.get("tool") or "도구" for st in steps if isinstance(st, dict)]
            if step_titles:
                print(f"  🔧 실행한 도구({len(step_titles)}개): {', '.join(step_titles[:8])}")
        print(f"{text}")

    if brain_info.get("recentSteps"):
        print("\n--- 📜 AGY 세션 내부 Transcript 최근 스텝 ---")
        for st in brain_info["recentSteps"]:
            print(f"  • [{st.get('type')}] {st.get('summary')}")
    return 0


def _launch_background_watcher(room_id: str, task_id: str | None = None) -> None:
    """하위 세션 완료 감시자(Watcher)를 백그라운드 프로세스로 분기(detach)한다."""
    import subprocess
    cmd = [
        sys.executable,
        os.path.abspath(__file__),
        "watch",
        room_id,
        "--notify-master",
    ]
    if task_id:
        cmd.extend(["--task-id", task_id])
    try:
        subprocess.Popen(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception as exc:
        print(f"⚠️ 백그라운드 감시자 실행 실패: {exc}", file=sys.stderr)


def cmd_send(args: argparse.Namespace) -> int:
    payload = {
        "action": "send",
        "target": args.target.strip(),
        "prompt": args.message.strip(),
        "wait": not args.async_mode,
    }
    if getattr(args, "effort", None):
        payload["effort"] = args.effort.strip()
    if getattr(args, "model", None):
        payload["model"] = args.model.strip()

    timeout = 30 if args.async_mode else 620
    res = _api_request("POST", "/api/orchestrator/dispatch", payload=payload, timeout=timeout)
    if not res.get("ok"):
        print(f"⚠️ 세션 메시지 전송 실패: {res.get('error')}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0

    room_title = res.get("title") or args.target
    room_id = res.get("roomId") or args.target
    session_id = res.get("sessionId") or ""
    task_id = res.get("taskId")
    effort_info = f" [effort: {args.effort}]" if getattr(args, "effort", None) else ""
    if args.async_mode or res.get("status") != "completed":
        print(f"✅ [{room_title}] (ID: {room_id}) 세션에 작업을 비동기로 지시했습니다.{effort_info} (상태: {res.get('status')})")
        if getattr(args, "notify", False):
            _launch_background_watcher(room_id, task_id)
            print(f"🛰️ 완료 감시자(Watcher) 가동: 작업 종료 시 마스터 에이전트에게 자동 보고됩니다.")
        return 0

    print(f"✅ [{room_title}] (AGY Session: {session_id or room_id}) 실행 완료 ({res.get('elapsedSeconds', 0)}초){effort_info}:")
    print("--- 🤖 세션 응답 결과 ---")
    print(res.get("reply") or "(응답 없음)")
    return 0


def cmd_spawn(args: argparse.Namespace) -> int:
    payload = {
        "action": "spawn",
        "title": args.title.strip(),
        "prompt": args.message.strip(),
        "wait": not args.async_mode,
    }
    if getattr(args, "effort", None):
        payload["effort"] = args.effort.strip()
    if getattr(args, "model", None):
        payload["model"] = args.model.strip()
    if getattr(args, "force_new", False):
        payload["forceNew"] = True

    timeout = 30 if args.async_mode else 620
    res = _api_request("POST", "/api/orchestrator/dispatch", payload=payload, timeout=timeout)
    if not res.get("ok"):
        print(f"⚠️ 신규 세션 스폰 실패: {res.get('error')}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0

    room_title = res.get("title") or args.title
    room_id = res.get("roomId") or ""
    session_id = res.get("sessionId") or ""
    task_id = res.get("taskId")
    reused = bool(res.get("reused"))
    effort_info = f" [effort: {args.effort}]" if getattr(args, "effort", None) else ""
    if args.async_mode or res.get("status") != "completed":
        if reused:
            sim_str = res.get("matchedSimilarity", "-")
            print(
                f"♻️ 유사한 기존 채팅방 [{room_title}] (Room ID: {room_id}, 유사도: {sim_str})을 찾아 이어서 작업을 시작했습니다.{effort_info}"
            )
        else:
            print(f"🚀 새 채팅방(AGY 세션) [{room_title}] (Room ID: {room_id})을 생성하고 백그라운드로 작업을 시작했습니다.{effort_info}")
        if getattr(args, "notify", False):
            _launch_background_watcher(room_id, task_id)
            print(f"🛰️ 완료 감시자(Watcher) 가동: 작업 종료 시 마스터 에이전트에게 자동 보고됩니다.")
        return 0

    if reused:
        print(
            f"♻️ 유사한 기존 채팅방 [{room_title}] (AGY Session: {session_id or room_id}) 이어서 실행 완료 ({res.get('elapsedSeconds', 0)}초){effort_info}:"
        )
        print("--- 🤖 기존 세션 이어서 응답 결과 ---")
    else:
        print(f"🚀 새 채팅방(AGY 세션) [{room_title}] (AGY Session: {session_id or room_id}) 생성 및 실행 완료 ({res.get('elapsedSeconds', 0)}초){effort_info}:")
        print("--- 🤖 새 세션 응답 결과 ---")
    print(res.get("reply") or "(응답 없음)")
    return 0


def cmd_watch(args: argparse.Namespace) -> int:
    target = args.target.strip()
    task_id = (getattr(args, "task_id", None) or "").strip()
    notify_master = bool(getattr(args, "notify_master", False))
    timeout = max(10, int(getattr(args, "timeout", 600)))
    interval = max(0.5, float(getattr(args, "interval", 2.0)))

    import time
    start_time = time.time()
    last_feed = ""
    seen_running = False

    # 1. 대상 세션 확인 (서버 재기동 중일 수 있으므로 최대 30초간 재시도)
    read_res = None
    for attempt in range(15):
        read_res = _api_request("GET", f"/api/orchestrator/session/read?target={urllib.parse.quote(target)}&limit=5", timeout=15)
        if read_res.get("ok"):
            break
        if attempt < 14:
            time.sleep(2.0)

    if not read_res or not read_res.get("ok"):
        print(f"⚠️ 감시 대상 세션 조회 실패: {read_res.get('error') if read_res else '연결 불가'}", file=sys.stderr)
        return 1

    session_info = read_res.get("session") or {}
    room_id = session_info.get("roomId") or target
    room_title = session_info.get("title") or target
    initial_msg_count = session_info.get("messageCount", 0)

    # 2. 완료 대기 루프
    while time.time() - start_time < timeout:
        poll_res = _api_request("GET", f"/api/orchestrator/session/read?target={urllib.parse.quote(room_id)}&limit=5", timeout=15)
        if poll_res.get("ok"):
            s = poll_res.get("session") or {}
            is_running = bool(s.get("isRunning"))
            current_count = s.get("messageCount", 0)
            feed = s.get("liveFeed") or ""

            if is_running:
                seen_running = True
                if feed and feed != last_feed:
                    last_feed = feed
            elif seen_running or (current_count > initial_msg_count) or (time.time() - start_time >= 3.0 and not is_running):
                # 세션이 실행 중이었다가 완료되었거나, 새 메시지가 도착했거나, 비실행 상태 확정 시
                messages = poll_res.get("messages") or []
                last_reply = ""
                for m in reversed(messages):
                    if (m.get("role") or m.get("type")) in ("assistant", "agent"):
                        last_reply = str(m.get("text") or "").strip()
                        break

                elapsed = max(1, int(time.time() - start_time))
                task_status = "done"
                if task_id:
                    t_res = _api_request("GET", "/api/orchestrator/tasks?limit=50&include_closed=1", timeout=15)
                    if t_res.get("ok"):
                        for t in (t_res.get("tasks") or []):
                            if t.get("id") == task_id:
                                task_status = t.get("status") or task_status
                                break

                if args.json:
                    print(json.dumps({
                        "ok": True,
                        "status": "completed",
                        "roomId": room_id,
                        "title": room_title,
                        "taskId": task_id,
                        "taskStatus": task_status,
                        "elapsedSeconds": elapsed,
                        "reply": last_reply,
                    }, ensure_ascii=False, indent=2))
                else:
                    print(f"🏁 [{room_title}] (ID: {room_id}) 작업 완료 ({elapsed}초 소요, 상태: {task_status})")
                    if last_reply:
                        preview = last_reply[:300] + ("..." if len(last_reply) > 300 else "")
                        print(f"--- 🤖 하위 세션 응답 요약 ---\n{preview}")

                if notify_master:
                    report_lines = [
                        "[하위 작업 완료 보고]",
                        f"• 대상 방: {room_title} (Room ID: {room_id})",
                    ]
                    if task_id:
                        report_lines.append(f"• 작업 ID: {task_id} (상태: {task_status})")
                    report_lines.append(f"• 소요 시간: {elapsed}초")
                    report_lines.append(f"• 하위 에이전트 응답 요약:\n{last_reply[:500] if last_reply else '(응답 내용 없음)'}")
                    report_lines.append(f"\n※ 마스터 지침: 위 작업 결과를 확인하고, 작업 원장(session-ctl task {task_id or '<taskId>'} --close)을 갱신하거나 다음 후속 작업을 진행하세요.")

                    notify_payload = {
                        "message": "\n".join(report_lines),
                        "roomId": room_id,
                        "taskId": task_id,
                    }
                    n_res = None
                    for n_attempt in range(5):
                        n_res = _api_request("POST", "/api/orchestrator/notify", payload=notify_payload, timeout=30)
                        if n_res.get("ok"):
                            print(f"📢 마스터 에이전트(__core__)에게 완료 보고를 전달하여 후속 턴을 트리거했습니다.")
                            break
                        if n_attempt < 4:
                            time.sleep(2.0)
                    if not n_res or not n_res.get("ok"):
                        print(f"⚠️ 마스터 완료 보고 전달 실패: {n_res.get('error') if n_res else '연결 불가'}", file=sys.stderr)

                return 0

        time.sleep(interval)

    print(f"⚠️ 감시 타임아웃 ({timeout}초 경과): 세션이 시간 내에 완료되지 않았습니다.", file=sys.stderr)
    return 1


def cmd_notify(args: argparse.Namespace) -> int:
    payload = {
        "message": args.message.strip(),
    }
    if getattr(args, "task_id", None):
        payload["taskId"] = args.task_id.strip()
    if getattr(args, "room_id", None):
        payload["roomId"] = args.room_id.strip()

    res = _api_request("POST", "/api/orchestrator/notify", payload=payload, timeout=30)
    if not res.get("ok"):
        print(f"⚠️ 마스터 알림 전달 실패: {res.get('error')}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0

    print(f"✅ 마스터 에이전트(__core__)에게 완료 보고를 전달했습니다. (상태: {res.get('status')}, 대기순번: {res.get('queuePosition', 0)})")
    return 0


def cmd_graph(args: argparse.Namespace) -> int:
    res = _api_request("GET", "/api/orchestrator/graph", timeout=15)
    if not res.get("ok"):
        print(f"⚠️ 관계도 조회 실패: {res.get('error')}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(res.get("graph") or {}, ensure_ascii=False, indent=2))
        return 0

    g = res.get("graph") or {}
    master = g.get("master") or {}
    nodes = g.get("nodes") or []
    patrol = g.get("patrol") or {}
    summary = g.get("summary") or {}

    m_status = master.get("status", "idle")
    status_icon = "🟢 실행 중" if m_status == "running" else ("🟡 점검 중" if m_status == "patrolling" else "⚪ 대기 중")
    print("=== 👑 마스터-슬레이브 관계도 및 모니터링 현황 ===")
    print(f"👑 마스터 에이전트 (__core__) [{status_icon}]")
    if master.get("feed"):
        print(f"   진행: {master['feed']}")

    p_status = patrol.get("status", "idle")
    p_info = f"주기: {patrol.get('intervalSeconds', 300)}초 | 상태: {p_status} | 총 점검: {patrol.get('runs', 0)}회 | 양보: {patrol.get('preempted', 0)}회"
    print(f"   감독 루프: {p_info}")
    if patrol.get("lastReason"):
        print(f"   최근 점검: [{patrol['lastReason']}] {patrol.get('lastResultPreview', '')[:100]}")

    print("\n--- 🔗 연결된 하위 세션(슬레이브) 목록 ---")
    if not nodes:
        print("(연결된 하위 세션이 없습니다.)")
    for n in nodes:
        s = n.get("status", "idle")
        icon = "🟢" if s == "running" else ("🟡" if s == "queued" else ("⚠️" if s in ("stalled", "failed", "lost") else ("🔵" if s == "attention" else "⚪")))
        flag = f" [{n['statusLabel']}]"
        recent_flag = " (최근 대화)" if n.get("recentOnly") else ""
        print(f"{icon} [{n['id']}] {n.get('title')}{flag}{recent_flag}")
        if n.get("feed"):
            print(f"     ↳ 진행 상태: {n['feed']}")
        if n.get("summary"):
            print(f"     ↳ 📋 요약: {str(n['summary'])[:140]}")
        if n.get("tasks"):
            for t in n["tasks"]:
                t_icon = "📋" if not t.get("reviewed") else "✅"
                print(f"     ↳ {t_icon} 작업 [{t['id']}] ({t.get('statusLabel')}) {t.get('instruction')}")
                if t.get("lastNote"):
                    print(f"        판정 메모: {t['lastNote']}")

    print(f"\n📊 통계: 하위 세션 {summary.get('children', 0)}개 | 실행 중 {summary.get('running', 0)}개 | 검토 필요 {summary.get('attention', 0)}개 | 활성 위임 {summary.get('activeTasks', 0)}개")
    return 0


def cmd_tasks(args: argparse.Namespace) -> int:
    include_closed = 0 if args.active_only else 1
    res = _api_request("GET", f"/api/orchestrator/tasks?limit={args.limit}&include_closed={include_closed}", timeout=15)
    if not res.get("ok"):
        print(f"⚠️ 작업 원장 조회 실패: {res.get('error')}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0

    tasks = res.get("tasks") or []
    print(f"=== 📋 마스터 위임 작업 원장 (총 {len(tasks)}건) ===")
    if not tasks:
        print("(등록된 위임 작업이 없습니다.)")
        return 0

    for t in tasks:
        s = t.get("status", "queued")
        reviewed = "✅ 검토완료" if t.get("reviewed") else "⚠️ 검토필요"
        print(f"\n• [{t['id']}] ({s}) {reviewed} | 방: {t.get('title') or t.get('roomId')}")
        print(f"  지시: {t.get('instruction')}")
        if t.get("resultPreview"):
            print(f"  결과: {t['resultPreview'][:120]}")
        if t.get("error"):
            print(f"  오류: {t['error'][:120]}")
        if t.get("notes"):
            last_note = t["notes"][-1].get("text", "")
            print(f"  최근 판정: {last_note}")
    return 0


def cmd_task(args: argparse.Namespace) -> int:
    payload = {
        "taskId": args.task_id.strip(),
    }
    if args.note:
        payload["note"] = args.note.strip()
    if args.close:
        payload["close"] = True
    if args.status:
        payload["status"] = args.status.strip()

    res = _api_request("POST", "/api/orchestrator/task/update", payload=payload, timeout=15)
    if not res.get("ok"):
        print(f"⚠️ 작업 갱신 실패: {res.get('error')}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0

    t = res.get("task") or {}
    print(f"✅ 작업 [{t.get('id')}] 갱신 완료 (상태: {t.get('status')}, 검토: {t.get('reviewed')})")
    if t.get("notes"):
        print(f"   메모: {t['notes'][-1].get('text')}")
    return 0


def cmd_patrol(args: argparse.Namespace) -> int:
    if args.trigger:
        res = _api_request("POST", "/api/orchestrator/patrol/trigger", timeout=30)
        if not res.get("ok"):
            print(f"⚠️ 정기 점검 트리거 실패: {res.get('error')}", file=sys.stderr)
            return 1
        if args.json:
            print(json.dumps(res, ensure_ascii=False, indent=2))
            return 0
        msg = res.get("message") or ""
        if res.get("llmTriggered"):
            print(f"🚀 {msg or '마스터 복구 점검 턴이 적재되었습니다.'} ({res})")
        else:
            print(f"✅ {msg or '자동 점검 완료: 이상 없음'} ({res})")
        return 0

    res = _api_request("GET", "/api/orchestrator/graph", timeout=15)
    if not res.get("ok"):
        print(f"⚠️ 감독 상태 조회 실패: {res.get('error')}", file=sys.stderr)
        return 1
    g = res.get("graph") or {}
    patrol = g.get("patrol") or {}
    if args.json:
        print(json.dumps(patrol, ensure_ascii=False, indent=2))
        return 0
    print("=== 🛰️ 마스터 감독 루프 & 점검 상태 ===")
    print(f"• 활성 여부 : {'활성화' if patrol.get('enabled') else '비활성화'}")
    print(f"• 점검 주기 : {patrol.get('intervalSeconds', 300)}초")
    print(f"• 상태       : {patrol.get('status')}")
    print(f"• 총 점검 횟수: {patrol.get('runs', 0)}회 (선점/양보: {patrol.get('preempted', 0)}회)")
    if patrol.get("lastRunAt"):
        import datetime
        dt = datetime.datetime.fromtimestamp(patrol["lastRunAt"]).strftime("%Y-%m-%d %H:%M:%S")
        print(f"• 최근 점검 시각: {dt}")
    if patrol.get("lastReason"):
        print(f"• 최근 점검 사유: {patrol['lastReason']}")
    if patrol.get("lastResultPreview"):
        print(f"• 최근 점검 보고: {patrol['lastResultPreview']}")
    return 0


def cmd_supervise(args: argparse.Namespace) -> int:
    """`agy_wrapper.py` (Sub-Agy + Inspector 루프)를 포그라운드 또는 백그라운드로 실행한다."""
    import subprocess
    import uuid

    script_dir = os.path.dirname(os.path.abspath(__file__))
    wrapper_script = os.path.join(script_dir, "agy_wrapper.py")
    task_id = (getattr(args, "task_id", None) or "").strip() or f"task_{uuid.uuid4().hex[:6]}"

    cmd = [
        sys.executable,
        wrapper_script,
        "--task-id",
        task_id,
        "--objective",
        args.objective.strip(),
        "--criteria",
        args.criteria.strip(),
        "--timeout",
        str(args.timeout),
        "--max-retries",
        str(args.max_retries),
    ]
    if getattr(args, "master_callback", None):
        cmd.extend(["--master-callback", args.master_callback.strip()])
    elif os.getenv("OSHYUN_ORCHESTRATOR_API_URL", "").strip():
        cb_base = os.getenv("OSHYUN_ORCHESTRATOR_API_URL", "").strip().rstrip("/")
        cmd.extend(["--master-callback", f"{cb_base}/v1/callbacks/task-events"])

    if getattr(args, "async_mode", False):
        log_path = f"/tmp/{task_id}_wrapper.log"
        log_f = open(log_path, "ab")
        try:
            proc = subprocess.Popen(
                cmd,
                stdout=log_f,
                stderr=subprocess.STDOUT,
                stdin=subprocess.DEVNULL,
                start_new_session=True,
            )
        finally:
            log_f.close()
        if args.json:
            print(json.dumps({"ok": True, "status": "started", "taskId": task_id, "pid": proc.pid, "log": log_path}, ensure_ascii=False))
        else:
            print(f"🚀 agy_wrapper 슈퍼바이저를 백그라운드로 기동했습니다. (task_id={task_id}, pid={proc.pid}, log={log_path})")
        return 0

    proc_res = subprocess.run(cmd)
    return proc_res.returncode


def cmd_summaries(args: argparse.Namespace) -> int:
    inc_val = 1 if getattr(args, "include_archived", False) else 0
    query = f"?limit={int(args.limit)}&includeArchived={inc_val}"
    res = _api_request("GET", f"/api/orchestrator/summaries{query}", timeout=15)
    if not res.get("ok"):
        print(f"⚠️ 하위 채팅 요약본 조회 실패: {res.get('error')}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0

    summaries = res.get("summaries") or []
    print(f"=== 📋 마스터 관리 하위 채팅 요약본 목록 (총 {len(summaries)}개) ===")
    if not summaries:
        print("관리 중인 하위 채팅 요약본이 없습니다.")
        return 0

    for idx, item in enumerate(summaries, 1):
        rid = item.get("roomId") or ""
        sid = item.get("sessionId") or "(미할당)"
        title = item.get("title") or rid
        busy = bool(item.get("busy") or item.get("isRunning"))
        q_cnt = int(item.get("taskCount") or 0)
        status_str = "🟢 실행/대기" if busy else f"⚪ 유휴 ({item.get('lastStatus') or '-'})"
        if item.get("archived"):
            status_str += " [보관]"
        updated_str = item.get("updatedAtFormatted") or ""
        print(f"\n[{idx}] 제목: {title} (작업 {q_cnt}건 | {status_str})")
        print(f"    • ID (roomId / sessionId): {rid} / {sid} | 갱신: {updated_str}")
        if item.get("summary"):
            print(f"    • 📋 요약본: {item['summary']}")
        if item.get("queries"):
            print(f"    • 💬 다룬 질문: {' / '.join(str(q) for q in item['queries'][-4:])}")
        if item.get("lastResult"):
            print(f"    • ✅ 최근 결과: {str(item['lastResult'])[:140]}")
    return 0


def cmd_summary(args: argparse.Namespace) -> int:
    payload: dict[str, object] = {
        "target": args.target.strip(),
    }
    if getattr(args, "summary", None) is not None:
        payload["summary"] = args.summary.strip()
    if getattr(args, "note", None) is not None:
        payload["note"] = args.note.strip()
    if getattr(args, "query", None) is not None:
        payload["query"] = args.query.strip()
    if getattr(args, "result", None) is not None:
        payload["resultSummary"] = args.result.strip()

    if len(payload) <= 1:
        print("⚠️ 요약본 텍스트 또는 --note / --query / --result 중 하나 이상을 입력하세요.", file=sys.stderr)
        return 1

    res = _api_request("POST", "/api/orchestrator/session/summary", payload=payload, timeout=15)
    if not res.get("ok"):
        print(f"⚠️ 요약본 갱신 실패: {res.get('error')}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0

    print(f"✅ [{res.get('roomId')}] 채팅방 요약본이 갱신되었습니다:")
    print(f"   📋 {res.get('summary') or '(비어 있음)'}")
    return 0


def cmd_memory(args: argparse.Namespace) -> int:
    if args.add:
        payload: dict = {
            "action": "add",
            "text": args.add,
            "title": args.title or "",
            "tier": args.tier or "hot",
            "kind": getattr(args, "kind", None) or "note",
            "roomId": getattr(args, "room_id", None) or "",
        }
        res = _api_request("POST", "/api/orchestrator/memory", payload, timeout=15)
    elif getattr(args, "batch", None):
        raw_b = str(args.batch).strip()
        if raw_b.startswith("@") and os.path.isfile(raw_b[1:]):
            with open(raw_b[1:], "r", encoding="utf-8") as bf:
                raw_b = bf.read()
        elif os.path.isfile(raw_b):
            with open(raw_b, "r", encoding="utf-8") as bf:
                raw_b = bf.read()
        try:
            ops = json.loads(raw_b)
        except Exception as exc:
            print(f"⚠️ --batch JSON 파싱 실패: {exc}", file=sys.stderr)
            return 1
        res = _api_request("POST", "/api/orchestrator/memory", {"action": "batch", "operations": ops}, timeout=20)
    elif getattr(args, "update", None):
        res = _api_request(
            "POST",
            "/api/orchestrator/memory",
            {
                "action": "update",
                "itemId": args.update,
                "text": getattr(args, "text", None),
                "title": args.title or None,
                "tier": args.tier or None,
            },
            timeout=15,
        )
    elif getattr(args, "rebalance", False):
        res = _api_request("POST", "/api/orchestrator/memory", {"action": "rebalance"}, timeout=60)
    elif getattr(args, "move", None):
        res = _api_request(
            "POST",
            "/api/orchestrator/memory",
            {"action": "move", "itemId": args.move, "toTier": getattr(args, "to_tier", None) or "hot"},
            timeout=15,
        )
    elif getattr(args, "delete", None):
        res = _api_request("POST", "/api/orchestrator/memory", {"action": "delete", "itemId": args.delete}, timeout=15)
    elif getattr(args, "promote", None):
        res = _api_request("POST", "/api/orchestrator/memory", {"action": "promote", "fromTier": args.promote}, timeout=15)
    elif args.demote:
        res = _api_request("POST", "/api/orchestrator/memory", {"action": "demote", "fromTier": args.demote}, timeout=15)
    elif args.clear:
        res = _api_request("POST", "/api/orchestrator/memory", {"action": "clear", "tier": args.clear}, timeout=15)
    else:
        query = f"?limit={max(1, int(args.limit))}"
        if args.tier and args.tier != "all":
            query += f"&tier={args.tier}"
        res = _api_request("GET", f"/api/orchestrator/memory{query}", timeout=15)

    if not res.get("ok"):
        # API 통신 불가 시 로컬 모듈(master_memory) 직접 fallback
        try:
            repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
            for sp in [
                os.path.join(repo_root, ".venv", "lib", "python3.9", "site-packages"),
                os.path.join(repo_root, ".venv", "lib", "python3.10", "site-packages"),
                os.path.join(repo_root, ".venv", "lib", "python3.11", "site-packages"),
                os.path.join(repo_root, "src", "bot"),
            ]:
                if os.path.isdir(sp) and sp not in sys.path:
                    sys.path.insert(0, sp)
            import master_memory
            lim = max(1, int(getattr(args, "limit", 20)))
            if args.add:
                op = master_memory.add_memory(
                    args.add,
                    title=args.title or "",
                    tier=args.tier or "hot",
                    kind=getattr(args, "kind", None) or "note",
                    room_id=getattr(args, "room_id", None) or "",
                )
                res = {"ok": True, "lastOperation": op.get("lastOperation"), **master_memory.get_memory_snapshot(limit_per_tier=lim)}
            elif getattr(args, "batch", None):
                raw_b = str(args.batch).strip()
                if raw_b.startswith("@") and os.path.isfile(raw_b[1:]):
                    with open(raw_b[1:], "r", encoding="utf-8") as bf:
                        raw_b = bf.read()
                elif os.path.isfile(raw_b):
                    with open(raw_b, "r", encoding="utf-8") as bf:
                        raw_b = bf.read()
                op = master_memory.apply_memory_batch(json.loads(raw_b))
                res = {"ok": True, "lastOperation": op.get("lastOperation"), **master_memory.get_memory_snapshot(limit_per_tier=lim)}
            elif getattr(args, "update", None):
                op = master_memory.apply_memory_batch([{
                    "action": "update",
                    "id": args.update,
                    "text": getattr(args, "text", None),
                    "title": args.title or None,
                    "tier": args.tier or None,
                }])
                res = {"ok": True, "lastOperation": op.get("lastOperation"), **master_memory.get_memory_snapshot(limit_per_tier=lim)}
            elif getattr(args, "rebalance", False):
                if getattr(master_memory, "LLM_SUMMARY_ENABLED", False):
                    import asyncio
                    op = asyncio.run(master_memory.rebalance_memory_with_llm())
                else:
                    op = master_memory.rebalance_memory()
                res = {"ok": True, **op}
            elif getattr(args, "move", None):
                op = master_memory.move_item(args.move, getattr(args, "to_tier", None) or "hot")
                res = {"ok": True, "lastOperation": op.get("lastOperation"), **master_memory.get_memory_snapshot(limit_per_tier=lim)}
            elif getattr(args, "delete", None):
                op = master_memory.delete_item(args.delete)
                res = {"ok": True, "lastOperation": op.get("lastOperation"), **master_memory.get_memory_snapshot(limit_per_tier=lim)}
            elif getattr(args, "promote", None):
                op = master_memory.promote_tier(args.promote)
                res = {"ok": True, "lastOperation": op.get("lastOperation"), **master_memory.get_memory_snapshot(limit_per_tier=lim)}
            elif args.demote:
                op = master_memory.demote_tier(args.demote)
                res = {"ok": True, "lastOperation": op.get("lastOperation"), **master_memory.get_memory_snapshot(limit_per_tier=lim)}
            elif args.clear:
                op = master_memory.clear_tier(args.clear)
                res = {"ok": True, "lastOperation": op.get("lastOperation"), **master_memory.get_memory_snapshot(limit_per_tier=lim)}
            else:
                t = args.tier if args.tier and args.tier != "all" else None
                res = {"ok": True, **master_memory.get_memory_snapshot(tier=t, limit_per_tier=lim)}
        except Exception:
            pass

    if not res.get("ok"):
        print(f"⚠️ 마스터 메모리 작업 실패: {res.get('error')}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0

    op = res.get("lastOperation")
    if isinstance(op, dict):
        act = op.get("action")
        if act == "add":
            print(f"✅ [{op.get('tier')}] 메모리 저장 완료 (연쇄 이동: {op.get('cascaded', 0)}건, 삭제: {op.get('dropped', 0)}건)")
        elif act == "demote":
            print(f"⬇️ [{op.get('fromTier')} → {op.get('toTier')}] {op.get('movedCount', 0)}건 이동 완료 (전체 연쇄: {op.get('cascaded', 0)}건)")
        elif act == "promote":
            print(f"⬆️ [{op.get('fromTier')} → {op.get('toTier')}] {op.get('movedCount', 0)}건 승격 완료 (전체 연쇄: {op.get('cascaded', 0)}건)")
        elif act == "move":
            print(f"🔀 [{op.get('fromTier')} → {op.get('toTier')}] 항목({op.get('itemId')}) 이동 완료 (전체 연쇄: {op.get('cascaded', 0)}건)")
        elif act == "delete":
            print(f"🗑️ [{op.get('fromTier')}] 항목({op.get('itemId')}) 삭제 완료")
        elif act == "rebalance":
            print(
                f"⚖️ 메모리 리밸런싱 완료 "
                f"(잡음삭제: {op.get('purged', 0)}건, 요약: {op.get('summarized', 0)}건, "
                f"승격: {op.get('promoted', 0)}건, 강등: {op.get('demoted', 0)}건, "
                f"중복제거: {op.get('deduped', 0)}건, 정리: {op.get('cleaned', 0)}건, "
                f"연쇄: {op.get('cascaded', 0)}건, 방출: {op.get('dropped', 0)}건)"
            )
        elif act == "clear":
            print(f"🧹 [{op.get('tier')}] 메모리 {op.get('removedCount', 0)}건 비우기 완료")

    tiers_map = res.get("tiers") or {}
    order = res.get("tierOrder") or ["hot", "warm", "cold", "freeze"]
    print(f"=== 💾 마스터 4계층 메모리 (총 {res.get('totalItems', 0)}건 / {res.get('totalChars', 0)}자) ===")
    for t in order:
        info = tiers_map.get(t)
        if not isinstance(info, dict):
            continue
        print(
            f"\n[{t.upper()}] {info.get('label', t)} — "
            f"{info.get('itemCount', 0)}/{info.get('maxItems', 0)}건 · "
            f"{info.get('charCount', 0)}/{info.get('maxChars', 0)}자 ({info.get('usagePct', 0)}%)"
        )
        items = info.get("items") or []
        if not items:
            print("  (비어 있음)")
            continue
        for it in items:
            title_part = f"[{it.get('title')}] " if it.get("title") else ""
            print(f"  • ({it.get('id')}) {title_part}{it.get('text')}")
    return 0


def cmd_reset(args: argparse.Namespace) -> int:
    mode = "clear" if args.clear_memory else (args.memory_mode or "cascade")
    res = _api_request(
        "POST",
        "/api/orchestrator/reset",
        {
            "memoryMode": mode,
            "clearDoneTasks": bool(args.clear_done_tasks),
        },
        timeout=30,
    )
    if not res.get("ok"):
        print(f"⚠️ 마스터 에이전트 초기화 실패: {res.get('error')}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0

    mem = res.get("memory") or {}
    print(f"🧹 마스터 에이전트(`{res.get('roomId')}`) 초기화 완료")
    print(f"   • 메모리 정책: {res.get('memoryMode')} (잔여 {mem.get('totalItems', 0)}건)")
    print(f"   • 종결 태스크 정리: {res.get('clearedTasks', 0)}건")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="session-ctl",
        description="총괄 에이전트용 AGY 채팅 세션 모니터링 및 메시지 디스패치 도구",
    )
    sub = parser.add_subparsers(dest="subcommand", required=True)

    # list
    p_list = sub.add_parser("list", help="전체 채팅방(AGY 세션) 목록 및 실시간 상태 조회")
    p_list.add_argument("--limit", type=int, default=30, help="최대 조회 개수 (기본: 30)")
    p_list.add_argument("--json", action="store_true", help="JSON 형식으로 출력")
    p_list.set_defaults(func=cmd_list)

    # summaries
    p_summaries = sub.add_parser("summaries", help="마스터가 관리 중인 하위 채팅 요약본 목록 조회")
    p_summaries.add_argument("--limit", type=int, default=30, help="최대 조회 개수 (기본: 30)")
    p_summaries.add_argument("--include-archived", action="store_true", help="보관(아카이브)된 채팅방 요약도 함께 조회")
    p_summaries.add_argument("--json", action="store_true", help="JSON 형식으로 출력")
    p_summaries.set_defaults(func=cmd_summaries)

    # summary
    p_summary = sub.add_parser("summary", help="특정 하위 채팅방의 요약본 갱신/보강")
    p_summary.add_argument("target", help="대상 채팅방의 Room ID, Session ID, 또는 제목 키워드")
    p_summary.add_argument("summary", nargs="?", default=None, help="저장할 채팅방 요약본 텍스트 (500자 이내)")
    p_summary.add_argument("--note", help="요약본에 반영할 마스터 검토 메모")
    p_summary.add_argument("--query", help="요약본에 추가할 대표 질문/주제")
    p_summary.add_argument("--result", help="요약본에 반영할 최근 결과 요약")
    p_summary.add_argument("--json", action="store_true", help="JSON 형식으로 출력")
    p_summary.set_defaults(func=cmd_summary)

    # read
    p_read = sub.add_parser("read", help="특정 채팅방(AGY 세션)의 대화 내역 및 브레인 로그 읽기")
    p_read.add_argument("target", help="대상 채팅방의 Room ID, Session ID, 또는 제목 키워드")
    p_read.add_argument("--limit", type=int, default=20, help="최근 메시지 조회 개수 (기본: 20)")
    p_read.add_argument("--include-brain", action="store_true", help="AGY brain transcript 내부 스텝 요약도 함께 조회")
    p_read.add_argument("--json", action="store_true", help="JSON 형식으로 출력")
    p_read.set_defaults(func=cmd_read)

    # send
    p_send = sub.add_parser("send", help="특정 채팅방(AGY 세션)에 메시지를 보내 작업 실행")
    p_send.add_argument("target", help="대상 채팅방의 Room ID, Session ID, 또는 제목 키워드")
    p_send.add_argument("message", help="전달할 프롬프트/지시 메시지")
    p_send.add_argument("--effort", choices=["low", "medium", "high", "max"], help="작업 복잡도에 따른 추론 강도 동적 지정 (low|medium|high|max)")
    p_send.add_argument("--model", type=str, help="사용할 특정 모델명 지정 (선택)")
    p_send.add_argument("--async", dest="async_mode", action="store_true", help="응답 완료를 기다리지 않고 백그라운드로 즉시 위임 (기본값)")
    p_send.add_argument("--wait", dest="async_mode", action="store_false", help="대상 세션이 답변을 완료할 때까지 대기 후 결과 반환 (명시적 동기 대기)")
    p_send.add_argument("--notify", "-n", action="store_true", help="작업 완료 시 마스터 에이전트에게 자동으로 결과 보고를 전송하여 후속 작업 트리거")
    p_send.add_argument("--json", action="store_true", help="JSON 형식으로 출력")
    p_send.set_defaults(func=cmd_send, async_mode=True)

    # spawn
    p_spawn = sub.add_parser("spawn", help="새 채팅방(신규 AGY 세션)을 생성하거나 유사한 기존 채팅방을 이어서 작업 지시")
    p_spawn.add_argument("title", help="새로 만들 채팅방 제목")
    p_spawn.add_argument("message", help="새 세션에 전달할 첫 프롬프트/지시 메시지")
    p_spawn.add_argument("--effort", choices=["low", "medium", "high", "max"], help="신규 세션의 추론 강도 지정 (low|medium|high|max)")
    p_spawn.add_argument("--model", type=str, help="신규 세션의 모델명 지정 (선택)")
    p_spawn.add_argument("--force-new", action="store_true", help="유사한 기존 채팅방이 있어도 재사용하지 않고 무조건 새 세션 생성")
    p_spawn.add_argument("--async", dest="async_mode", action="store_true", help="응답 완료를 기다리지 않고 백그라운드로 즉시 위임 (기본값)")
    p_spawn.add_argument("--wait", dest="async_mode", action="store_false", help="새 세션이 첫 답변을 완료할 때까지 대기 후 결과 반환 (명시적 동기 대기)")
    p_spawn.add_argument("--notify", "-n", action="store_true", help="작업 완료 시 마스터 에이전트에게 자동으로 결과 보고를 전송하여 후속 작업 트리거")
    p_spawn.add_argument("--json", action="store_true", help="JSON 형식으로 출력")
    p_spawn.set_defaults(func=cmd_spawn, async_mode=True)

    # watch
    p_watch = sub.add_parser("watch", help="특정 채팅방(AGY 세션)의 응답 종료를 감시하고 완료 시 결과 출력 또는 마스터 보고")
    p_watch.add_argument("target", help="감시할 채팅방의 Room ID, Session ID, 또는 제목 키워드")
    p_watch.add_argument("--task-id", help="연결된 마스터 위임 작업 ID (선택)")
    p_watch.add_argument("--notify-master", "-n", action="store_true", help="작업 완료 시 마스터 에이전트(__core__)에게 완료 보고를 자동 전송")
    p_watch.add_argument("--timeout", type=int, default=600, help="최대 감시 대기 시간(초) (기본: 600)")
    p_watch.add_argument("--interval", type=float, default=2.0, help="상태 확인 폴링 주기(초) (기본: 2.0)")
    p_watch.add_argument("--json", action="store_true", help="JSON 형식으로 출력")
    p_watch.set_defaults(func=cmd_watch)

    # notify
    p_notify = sub.add_parser("notify", help="마스터 에이전트(__core__)에게 완료 보고 또는 지시를 전달하여 새 턴 트리거")
    p_notify.add_argument("message", help="마스터 에이전트에게 보낼 보고/알림 내용")
    p_notify.add_argument("--task-id", help="관련 작업 ID (선택)")
    p_notify.add_argument("--room-id", help="관련 대화방 ID (선택)")
    p_notify.add_argument("--json", action="store_true", help="JSON 형식으로 출력")
    p_notify.set_defaults(func=cmd_notify)

    # graph
    p_graph = sub.add_parser("graph", help="마스터-슬레이브 관계도 및 실시간 연결 상태 조회")
    p_graph.add_argument("--json", action="store_true", help="JSON 형식으로 출력")
    p_graph.set_defaults(func=cmd_graph)

    # tasks
    p_tasks = sub.add_parser("tasks", help="마스터 위임 작업 원장(Task Ledger) 목록 조회")
    p_tasks.add_argument("--limit", type=int, default=50, help="최대 조회 개수 (기본: 50)")
    p_tasks.add_argument("--active-only", action="store_true", help="종결되지 않은 활성 작업만 조회")
    p_tasks.add_argument("--json", action="store_true", help="JSON 형식으로 출력")
    p_tasks.set_defaults(func=cmd_tasks)

    # task
    p_task = sub.add_parser("task", help="위임 작업 상태 갱신, 검토 메모 추가 또는 종결")
    p_task.add_argument("task_id", help="작업 ID (예: mt-12345678)")
    p_task.add_argument("--note", help="작업에 추가할 검토/판정 메모")
    p_task.add_argument("--close", action="store_true", help="작업을 종결(closed) 처리")
    p_task.add_argument("--status", help="작업 상태 직접 변경 (queued, running, stalled, done, failed, closed 등)")
    p_task.add_argument("--json", action="store_true", help="JSON 형식으로 출력")
    p_task.set_defaults(func=cmd_task)

    # patrol
    p_patrol = sub.add_parser("patrol", help="마스터 감독 루프 현황 확인 또는 즉시 점검 트리거")
    p_patrol.add_argument("--trigger", action="store_true", help="정기 점검 턴을 즉시 수동 트리거")
    p_patrol.add_argument("--json", action="store_true", help="JSON 형식으로 출력")
    p_patrol.set_defaults(func=cmd_patrol)

    # supervise
    p_sup = sub.add_parser("supervise", help="agy -p 기반 Sub-Agy + Inspector 자동 검수 래퍼(agy_wrapper) 실행")
    p_sup.add_argument("--task-id", help="고유 태스크 ID (생략 시 자동 생성)")
    p_sup.add_argument("--objective", required=True, help="서브 에이전트 작업 목표")
    p_sup.add_argument("--criteria", required=True, help="Inspector 검증 완료 기준")
    p_sup.add_argument("--timeout", type=int, default=120, help="Sub-Agy 1회 타임아웃(초, 기본: 120)")
    p_sup.add_argument("--max-retries", type=int, default=2, help="PARTIAL 시 최대 보강 횟수 (기본: 2)")
    p_sup.add_argument("--master-callback", help="마스터 콜백 URL (생략 시 로컬 웹서버 /v1/callbacks/task-events)")
    p_sup.add_argument("--async", dest="async_mode", action="store_true", help="백그라운드로 즉시 스폰 후 반환")
    p_sup.add_argument("--json", action="store_true", help="JSON 형식으로 출력")
    p_sup.set_defaults(func=cmd_supervise, async_mode=False)

    # memory
    p_mem = sub.add_parser("memory", help="마스터 4계층 메모리(hot/warm/cold/freeze) 조회 및 관리")
    p_mem.add_argument("--tier", choices=["hot", "warm", "cold", "freeze", "all"], help="조회/추가 대상 계층")
    p_mem.add_argument("--add", help="새 메모리 항목 추가")
    p_mem.add_argument("--title", default="", help="--add 시 선택적 제목")
    p_mem.add_argument("--kind", default="note", help="--add 시 항목 유형 (기본: note)")
    p_mem.add_argument("--room-id", default="", help="--add 시 연관 roomId")
    p_mem.add_argument("--rebalance", action="store_true", help="4계층 메모리 중복 제거 및 최적 리밸런싱 실행")
    p_mem.add_argument("--promote", choices=["warm", "cold", "freeze"], help="지정 계층을 상위 계층으로 일괄 승격")
    p_mem.add_argument("--demote", choices=["hot", "warm", "cold"], help="지정 계층을 하위 계층으로 일괄 이동")
    p_mem.add_argument("--move", help="지정 항목 ID(itemId)를 다른 계층으로 자유 이동")
    p_mem.add_argument("--to-tier", choices=["hot", "warm", "cold", "freeze"], default="hot", help="--move 시 대상 계층 (기본: hot)")
    p_mem.add_argument("--delete", help="지정 항목 ID(itemId) 삭제")
    p_mem.add_argument("--update", help="지정 항목 ID(itemId) 본문/제목/계층 갱신")
    p_mem.add_argument("--text", help="--update 시 새 본문 요약")
    p_mem.add_argument("--batch", help="delete/update/move 배치 JSON 배열(또는 @파일경로)")
    p_mem.add_argument("--clear", choices=["hot", "warm", "cold", "freeze", "all"], help="지정 계층(또는 all) 비우기")
    p_mem.add_argument("--limit", type=int, default=20, help="계층별 조회 개수 제한 (기본: 20)")
    p_mem.add_argument("--json", action="store_true", help="JSON 형식으로 출력")
    p_mem.set_defaults(func=cmd_memory)

    # reset
    p_rst = sub.add_parser("reset", help="마스터 에이전트(__core__) 대화 및 세션 초기화")
    p_rst.add_argument(
        "--memory-mode",
        choices=["keep", "cascade", "clear"],
        default="keep",
        help="초기화 시 메모리 처리 정책 (keep: 글로벌 유지(기본), cascade: hot→warm 이동, clear: 전체 비우기)",
    )
    p_rst.add_argument("--clear-memory", action="store_true", help="4계층 메모리 전체까지 즉시 비우기")
    p_rst.add_argument("--clear-done-tasks", action="store_true", help="완료/실패/종결된 위임 작업 원장 정리")
    p_rst.add_argument("--json", action="store_true", help="JSON 형식으로 출력")
    p_rst.set_defaults(func=cmd_reset)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
